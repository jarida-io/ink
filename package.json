{
  "name": "@jarida/ink",
  "version": "1.0.0",
  "description": "A design library with a printed edge and a glass bar. Framework-agnostic tokens and behaviour, React and React Native bindings, and plain CSS for everything else.",
  "keywords": [
    "design-system",
    "design-tokens",
    "headless-ui",
    "react",
    "react-native",
    "expo",
    "css",
    "accessibility",
    "wcag",
    "framework-agnostic"
  ],
  "license": "Apache-2.0",
  "author": "Jerry Ochieng Anyumba",
  "homepage": "https://github.com/jarida-io/ink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarida-io/ink.git"
  },
  "bugs": {
    "url": "https://github.com/jarida-io/ink/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "default": "./dist/headless/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./css": "./dist/css/ink.css",
    "./ink.css": "./dist/css/ink.css",
    "./vite-alias": "./vite-alias.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "vite-alias.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:native && npm run build:css",
    "build:web": "tsc -p tsconfig.build.json",
    "build:native": "tsc -p tsconfig.build.native.json",
    "build:css": "mkdir -p dist/css && cp src/css/ink.css dist/css/ink.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck:native": "tsc -p tsconfig.native.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run typecheck:native && npm run test",
    "prepublishOnly": "npm run clean && npm run verify && npm run build",
    "gallery": "npm run build && node scripts/build-gallery.mjs gallery.html"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
