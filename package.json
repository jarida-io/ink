{
  "name": "@jarida/ink",
  "version": "1.0.0",
  "description": "The ink edge, as a design library. Tokens and components for React and React Native / Expo.",
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "expo",
    "design-tokens",
    "accessibility",
    "wcag",
    "jarida"
  ],
  "license": "Apache-2.0",
  "author": "Jerry Ochieng Anyumba",
  "homepage": "https://github.com/jarida-io/ink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarida-io/ink.git"
  },
  "bugs": {
    "url": "https://github.com/jarida-io/ink/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./web/ink.css": "./dist/web/ink.css",
    "./vite-alias": "./vite-alias.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "vite-alias.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:native && npm run build:css",
    "build:web": "tsc -p tsconfig.build.json",
    "build:native": "tsc -p tsconfig.build.native.json",
    "build:css": "cp src/web/ink.css dist/web/ink.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck:native": "tsc -p tsconfig.native.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run typecheck:native && npm run test",
    "prepublishOnly": "npm run clean && npm run verify && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
